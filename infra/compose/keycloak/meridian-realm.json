{
  "realm": "meridian",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "meridian-web",
      "name": "Meridian web arayüzü",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "meridian-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "meridian-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "meridian-dev-cli",
      "name": "YALNIZCA YEREL GELİŞTİRME: password grant ile test token'ı",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "meridian-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "meridian-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "aaaaaaaa-0000-4000-8000-0000000000a1",
      "username": "alice",
      "email": "alice@acme.test",
      "firstName": "Alice",
      "lastName": "Acme",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "id": "bbbbbbbb-0000-4000-8000-0000000000b1",
      "username": "bob",
      "email": "bob@beta.test",
      "firstName": "Bob",
      "lastName": "Beta",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    }
  ]
}